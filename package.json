{
  "name": "techmania",
  "version": "0.0.1",
  "description": "TECHMANIA website",
  "productName": "TECHMANIA",
  "author": "rogeraabbccdd <rogeraabbccdd@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "quasar dev -m ssr",
    "build": "quasar build -m ssr",
    "icons": "icongenie g -i ./public/assets/notes/basic.png",
    "start": "cd dist/ssr && bun run start",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "@quasar/quasar-ui-qmarkdown": "^2.0.5",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "lodash": "^4.18.1",
    "pinia": "^4.0.2",
    "quasar": "^2.27.0",
    "sanitize-html": "^2.17.6",
    "validator": "^13.15.35",
    "vee-validate": "^4.15.1",
    "vite-plugin-vue-layouts-next": "^2.1.0",
    "vue": "^3.5.40",
    "vue-gtag": "^3.7.1",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@quasar/app-vite": "^3.8.1",
    "@quasar/icongenie": "^6.1.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/validator": "^13.15.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/language-plugin-pug": "^2.2.12",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vue-pug": "^1.0.0-alpha.6",
    "globals": "^17.8.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "pug": "^3.0.4",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
