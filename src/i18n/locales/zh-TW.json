  "howtoplayPage": {
    "meta": {
      "title": "TECHMANIA {'|'} 遊玩方式",
      "description": "一款開源音樂遊戲，不論是否使用觸控螢幕皆可遊玩。"
    },
    "title": "遊玩方式",
    "scanlineNotice": "當掃描線經過音符中心時，擊打它！",
    "tabs": {
      "touch": "觸控",
      "keys": "鍵盤",
      "km": "鍵鼠"
    },
    "keysDesc": "鍵盤操作方式使用鍵盤上的這 4 行按鍵。\n每行按鍵對應螢幕上的 4 個軌道之一。\n要演奏特定軌道上的音符，請按下對應按鍵行中的任意按鍵。",
    "kmDesc": "KM 代表鍵盤與滑鼠（Keyboard and Mouse）。\n在鍵鼠操作方式中，您使用滑鼠來演奏某些類型的音符（基本音符、鎖鏈音符、拖動音符），並使用鍵盤演奏其他類型（長按音符、連打音符）。\n與鍵盤操作方式不同，在這裡您可以按下任意行的任意按鍵來演奏鍵盤音符，無論它們位於哪個軌道。",
    "notes": {
      "basic": {
        "title": "基本音符",
        "touchDesc": "當掃描線經過音符中心時點擊。",
        "keysDesc": "當掃描線經過音符中心時按下按鍵。",
        "kmDesc": "當掃描線經過音符中心時點擊滑鼠。"
      },
      "chain": {
        "title": "鎖鏈音符",
        "touchDesc": "順著掃描線的速度，沿著鎖鏈滑動。",
        "keysDesc": "將每個節點當作獨立的基本音符來演奏。",
        "kmDesc": "順著掃描線的速度，點擊並沿著鎖鏈拖曳。"
      },
      "drag": {
        "title": "拖動音符",
        "touchDesc": "順著掃描線的速度，沿著曲線滑動。\n您不需要精準地按時鬆開手指。",
        "keysDesc": "按住按鍵直到音符頭到達曲線末端。\n您不需要精準地按時鬆開按鍵。",
        "kmDesc": "順著掃描線的速度，點擊並沿著曲線拖曳。\n您不需要精準地按時鬆開滑鼠按鍵。"
      },
      "hold": {
        "title": "長按音符",
        "touchDesc": "按住音符頭，直到掃描線到達音符末端。\n您不需要精準地按時鬆開手指。",
        "keysDesc": "按住按鍵，直到掃描線到達音符末端。\n您不需要精準地按時鬆開按鍵。",
        "kmDesc": "按住任意按鍵，直到掃描線到達音符末端。\n您不需要精準地按時鬆開按鍵。"
      },
      "repeat": {
        "title": "連打音符",
        "touchDesc": "當掃描線經過連打頭音符中心及其後續的小音符時進行點擊。\n對於長音符，請按住連打頭，方式與長按音符相同。",
        "keysDesc": "當掃描線經過連打頭音符中心及其後續的小音符時按下按鍵。\n對於長音符，請按住按鍵，方式與拖動音符及長按音符相同。",
        "kmDesc": "當掃描線經過連打頭音符中心及其後續的小音符時按下任意按鍵。\n對於長音符，請按住按鍵，方式與長按音符相同。"
      }
    },
    "fever": {
      "activateNotice": "無論使用何種操作方式，您都可以透過以下任一方式發動 Fever。",
      "methods": {
        "touch": "點擊 Fever 按鈕",
        "keyboard": "按下 Space / Backspace / Numpad 0 / Numpad Enter",
        "click": "點擊 Fever 按鈕"
      },
      "effect": "在 Fever 啟用期間，將會提升演奏音符的判定。"
    }
  },
