  "howtoplayPage": {
    "meta": {
      "title": "TECHMANIA {'|'} 游戏说明",
      "description": "一款开源音乐游戏，无论是否使用触屏皆可游玩。"
    },
    "title": "游戏说明",
    "scanlineNotice": "当扫描线经过音符中心时，击打它！",
    "tabs": {
      "touch": "触屏",
      "keys": "键盘",
      "km": "键鼠"
    },
    "keysDesc": "键盘操作方式使用键盘上的这 4 行按键。\n每行按键对应屏幕上的 4 个轨道之一。\n要演奏特定轨道上的音符，请按下对应按键行中的任意按键。",
    "kmDesc": "KM 代表键盘与鼠标（Keyboard and Mouse）。\n在键鼠操作方式中，你使用鼠标来演奏某些类型的音符（基本音符、锁链音符、拖拽音符），并使用键盘演奏其他类型（长按音符、连打音符）。\n与键盘操作方式不同，在这里你可以按下任意行的任意按键来演奏键盘音符，无论它们位于哪个轨道。",
    "notes": {
      "basic": {
        "title": "基本音符",
        "touchDesc": "当扫描线经过音符中心时轻触。",
        "keysDesc": "当扫描线经过音符中心时按下按键。",
        "kmDesc": "当扫描线经过音符中心时点击鼠标。"
      },
      "chain": {
        "title": "锁链音符",
        "touchDesc": "顺着扫描线的速度，沿着锁链滑动。",
        "keysDesc": "将每个节点当作独立的基本音符来演奏。",
        "kmDesc": "顺着扫描线的速度，点击并沿着锁链拖拽。"
      },
      "drag": {
        "title": "拖拽音符",
        "touchDesc": "顺着扫描线的速度，沿着曲线滑动。\n你不需要精准地按时松开手指。",
        "keysDesc": "按住按键直到音符头到达曲线末端。\n你不需要精准地按时松开按键。",
        "kmDesc": "顺着扫描线的速度，点击并沿着曲线拖拽。\n你不需要精准地按时松开鼠标按键。"
      },
      "hold": {
        "title": "长按音符",
        "touchDesc": "按住音符头，直到扫描线到达音符末端。\n你不需要精准地按时松开手指。",
        "keysDesc": "按住按键，直到扫描线到达音符末端。\n你不需要精准地按时松开按键。",
        "kmDesc": "按住任意按键，直到扫描线到达音符末端。\n你不需要精准地按时松开按键。"
      },
      "repeat": {
        "title": "连打音符",
        "touchDesc": "当扫描线经过连打头音符中心及其后续的小音符时进行轻触。\n对于长音符，请按住连打头，方式与长按音符相同。",
        "keysDesc": "当扫描线经过连打头音符中心及其后续的小音符时按下按键。\n对于长音符，请按住按键，方式与拖拽音符及长按音符相同。",
        "kmDesc": "当扫描线经过连打头音符中心及其后续的小音符时按下任意按键。\n对于长音符，请按住按键，方式与长按音符相同。"
      }
    },
    "fever": {
      "activateNotice": "无论使用何种操作方式，你都可以通过以下任一方式发动 Fever。",
      "methods": {
        "touch": "轻触 Fever 按钮",
        "keyboard": "按下 Space / Backspace / Numpad 0 / Numpad Enter",
        "click": "点击 Fever 按钮"
      },
      "effect": "在 Fever 激活期间，将会提升演奏音符的判定。"
    }
  },
